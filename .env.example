# Neon / Postgres (Prisma)
DATABASE_URL=
DIRECT_URL=

# Firebase Admin — usado só pelos scripts de auditoria/migração do legado
# (farmhmmv, somente leitura). NUNCA commitar valores reais.
#
# Opção A: conteúdo do JSON da service account, em base64
#   base64 -i service-account.json | pbcopy
FIREBASE_ADMIN_CREDENTIALS_JSON=
# Opção B: caminho para o arquivo da service account (alternativa à opção A)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=farmhmmv
