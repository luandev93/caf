generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Config da instituição (seção 3 do SDD): nome, tipo, endereço, RT — dado, não hardcode
model Institution {
  id        String   @id @default(uuid())
  name      String
  type      String   // ex: UBS, HM, UPA
  address   String?
  rtName    String?  // nome do Responsável Técnico
  rtNumber  String?  // registro do RT (CRF/CRM/etc)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
