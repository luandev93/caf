generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Config da instituição (seção 3 do SDD): nome, tipo, endereço, RT — dado, não hardcode
model Institution {
  id        String   @id @default(uuid())
  name      String
  type      String   // ex: UBS, HM, UPA
  address   String?
  rtName    String?  // nome do Responsável Técnico
  rtNumber  String?  // registro do RT (CRF/CRM/etc)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLocations StockLocation[]
  users          User[]
}

// Substitui "estoques" do legado — um local de estoque físico sob uma Institution.
model StockLocation {
  id            String   @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches  Batch[]
  balances StockBalance[]
  legacyMappings LegacyMapping[]
}

// Produto canônico pós-saneamento — substitui "itens" do legado. `code` é o
// codigo legado quando existir e for confiável; não é a chave primária porque
// nem todo item legado tem código único (ver regras de saneamento).
model Product {
  id                   String   @id @default(uuid())
  code                 String?  @unique
  description          String
  activeIngredient     String?
  concentration        String?
  pharmaceuticalForm   String?
  unit                 String
  type                 String?  // MEDICAMENTO / MATERIAL / ...
  atcGroup             String?
  atcGroupName         String?
  pharmacologicalGroup String?
  controlled           String?
  thermolabile         Boolean  @default(false)
  highAlert            Boolean  @default(false)
  minStock             Int      @default(0)
  controlsBatch        Boolean  @default(true)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  batches        Batch[]
  balances       StockBalance[]
  legacyMappings LegacyMapping[]
}

// Substitui "lotes" do legado.
model Batch {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  batchNumber     String?
  expiresAt       DateTime?
  quantity        Decimal
  updatedAt       DateTime  @updatedAt

  @@unique([productId, stockLocationId, batchNumber, expiresAt])
}

// Substitui "saldos" do legado — fonte da verdade do saldo atual. Mantido
// separado de Batch porque nem todo item legado usa controle de lote
// (itens.controlaLote=false), então "saldos" segue sendo a única fonte
// confiável de saldo atual para esses casos.
model StockBalance {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  stockLocationId String
  stockLocation   StockLocation @relation(fields: [stockLocationId], references: [id])
  quantity        Decimal
  updatedAt       DateTime @updatedAt

  @@unique([productId, stockLocationId])
}

// Recuperação de "logins" — metadado de papel/contato para re-vincular depois
// a um provedor de auth novo. Não provisiona credenciais reais nesta fase.
model User {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String?
  active        Boolean  @default(true)
  hasLogin      Boolean  @default(false) // espelha pessoas.acesso.temLogin do legado
  role          String?                  // ex: adm / farmaceutico / auxiliar
  isRt          Boolean  @default(false)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  legacyMappings LegacyMapping[]
}

// Rastreabilidade genérica de tudo que foi migrado do legado — permite
// reimportações idempotentes (upsert por legacyCollection+legacyDocId) sem
// precisar de um campo legacyId espalhado em cada tabela.
model LegacyMapping {
  id               String   @id @default(uuid())
  entityType       String   // PRODUCT | STOCK_BALANCE | USER | ...
  legacyCollection String   // "itens" | "saldos" | "pessoas" | ...
  legacyDocId      String
  legacyCode       String?  // itens.codigo, quando existir
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  stockLocationId  String?
  stockLocation    StockLocation? @relation(fields: [stockLocationId], references: [id])
  importBatchId    String   // identifica a execução do script que criou esta linha
  importedAt       DateTime @default(now())

  @@unique([legacyCollection, legacyDocId])
}
